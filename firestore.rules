rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Services catalog
    match /services/{serviceId} {
      allow read: if true;
      allow write: if true;
    }

    // User profiles
    match /users/{userId} {
      allow read, write: if true;
    }
    
    // User bookings
    match /bookings/{bookingId} {
      allow read, write: if true;
    }
  }
}
